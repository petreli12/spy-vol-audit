# Copy to .env and fill in only the keys you need. All scripts run on yfinance alone
# for daily SPY/^VIX history; optional keys unlock intraday bars, FRED refresh, or
# Massive option-bar validation.

# Massive.com (formerly Polygon.io) option aggregates for Part 3/6 validation layers.
# Without it: structure_translation skips real-bar checks with --no-part3; vrp skips Part 6 with --no-part6.
MASSIVE_API_KEY=

# Legacy alias still honored by the scripts.
POLYGON_API_KEY=

# Alpaca market data (IEX) for 1h and 15m SPY bars when refreshing intraday caches.
# Without it: candle_markov uses yfinance for 1d only; 1h/15m need cache or Massive fallback.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# FRED API (free): refreshes 3-month T-bill (DTB3) for the synthetic options pricer.
# Without it: structure_translation uses a 2% flat rate fallback.
FRED_API_KEY=

# Optional friction overrides (defaults: 5% half-spread, $0.65/contract/fill).
FRICTION_HALF_SPREAD_PCT=0.05
FRICTION_COMMISSION_USD=0.65
